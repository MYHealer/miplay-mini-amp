# ══════════════════════════════════════════════════════════════════════
# MiPlay Mini Amp — 默认配置
# 目标：ESP32-S3FH4R2（4MB Flash + 2MB Quad PSRAM）
# ══════════════════════════════════════════════════════════════════════

CONFIG_IDF_TARGET="esp32s3"

# ── Flash：FH4R2 是片内 4MB，不是参考工程的 16MB ──
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ── ★★ PSRAM：FH4R2 是 Quad SPI，照抄参考工程的 OCT 会启动即 panic ──
# 错误症状：E (232) spiram: Virtual address not enough for PSRAM!
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y

# 大于此阈值的分配优先走 PSRAM
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# 内部 RAM 保留量，防止小分配挤占（参考工程用 98304，本机内部 RAM 更紧张）
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# 刻意不开：
#   CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP
#     在同类 MiPlay 工程（1.85C）上实测净亏 93 KiB，不盲抄参考工程的调优项。

# ── ★★ 必须开启：EXT_RAM_BSS_ATTR 只有在这个开关下才生效 ──
# 该宏控制 EXT_RAM_BSS_ATTR 是否展开为 .ext_ram.bss 段。未开启时宏展开为空，
# 于是 miplay_session.cpp:25 的 s_encrypt_buf（256KB + 32B）落在**内部 SRAM**
# 的 .bss 里 —— 而 ESP32-S3 内部 SRAM 总共只有 512KB。
#
# 这是实测结论，不是预设：第一次链接即报
#   section '.dram0.bss' will not fit in region 'dram0_0_seg'
#   region 'dram0_0_seg' overflowed by 48280 bytes
# map 文件里 .bss 合计 287 KiB，其中 s_encrypt_buf 独占 256.04 KiB，
# 其余 1707 个符号全部 ≤3.8 KiB —— 单这一个变量就是溢出本身。
#
# 安全性核实（开启前已确认，非默认假设）：
#   1. s_encrypt_buf 是 miplay_safety_encrypt() 的纯软件中转缓冲，
#      数据路径是 memcpy → mbedtls_aes_crypt_cbc → memcpy，无 DMA/无 ISR 访问。
#      （见 miplay_proto.cpp:120-134，中间那块 padded 本身就在
#       heap_caps_calloc(MALLOC_CAP_SPIRAM) 上，同一条路径已有 PSRAM 先例。）
#   2. 会话槽 s_sessions 同宏同段，文件内注释已声明"只在任务上下文访问"。
#   3. 开启后 lwip / net80211 / pp / bt 的 .bss 也会自动进 PSRAM
#      （Kconfig.spiram.common:135-136），这正是我们要的——内部 SRAM 让给栈与堆。
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# ── ★★ 分区表：必须显式选 CUSTOM，否则 partitions.csv 形同不存在 ──
# 实测踩坑：默认是 CONFIG_PARTITION_TABLE_SINGLE_APP，IDF 用自己内置的
# partitions_singleapp_coredump.csv（factory 只有 1MB），本工程的
# partitions.csv（factory 2.94MB）从未参与编译。
# 症状是构建末尾报 "app partition is too small for binary ... overflow 0x136f0"
# ——溢出量与二进制大小恰好差 1MB，这个数字关系就是"分区表用错"的判据。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── FreeRTOS ──
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ── lwIP ──
# MiPlay 并发占用：TCP listen + 控制会话×3 + RTSP + image + multi + UDP 发现 + mDNS
CONFIG_LWIP_MAX_SOCKETS=16

# ── 控制台：SuperMini 板载 USB-C 直连 GPIO19/20（USB-Serial-JTAG）──
# 插上 USB 即可看日志，无需外接 UART。若要用 UART0(GPIO43/44)，
# 改为 CONFIG_ESP_CONSOLE_UART_DEFAULT=y 并删掉下面两行。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ── 日志 ──
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ── coredump（调试期有用）──
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
